# In Vercel Production, set this to the final public origin only.
# Example: https://www.beymert.com.tr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional target for scripts/smoke-test.mjs
SMOKE_BASE_URL=http://localhost:3000

# Supabase CMS / Admin Panel
# Values are available from the Supabase project's Connect panel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
