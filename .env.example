# Local development may keep localhost.
# Local/non-Vercel environments may override the public origin here.
# Vercel deployments use the canonical origin from src/config/site.ts.
# Production canonical: https://www.beymerttuhafiye.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional target for scripts/smoke-test.mjs
SMOKE_BASE_URL=http://localhost:3000

# Supabase CMS / Admin Panel
# Values are available from the Supabase project's Connect panel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
